<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\ZoneTray.ico</ApplicationIcon>
    <AssemblyName>ZoneTray</AssemblyName>
    <RootNamespace>ZoneTray</RootNamespace>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SuppressWarnings>$(SuppressWarnings);NETSDK1175</SuppressWarnings>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\ZoneTray.ico" LogicalName="ZoneTray.ZoneTray.ico" />
  </ItemGroup>

</Project>
